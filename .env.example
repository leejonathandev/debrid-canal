# Get your API key at https://real-debrid.com/apitoken
REALDEBRID_API_KEY=
PORT=3000
# Local development can use HTTP. Docker Compose always sets production.
NODE_ENV=development
# Required in production: generate with openssl rand -hex 32 (never commit it).
# Blank in development uses a fresh, temporary random secret on each start.
SESSION_SECRET=
# Trusted reverse-proxy hops; 1 for a single Traefik hop. Never use true.
TRUST_PROXY=1
LOG_LEVEL=info
# Requests per client IP per 15 minutes (CSRF also counts toward the API limit).
RATE_LIMIT_API=300
RATE_LIMIT_CSRF=30
