# Real-Drid API key — get one at https://real-debrid.com/apitoken
# Required. The app will warn on boot if this is missing and `/ready` will return 503.
REALDEBRID_API_KEY=

# Port to listen on.
# Default: 3000
PORT=3000

# Node environment. Set to "production" in deployments to enable secure cookies.
# Default: development
NODE_ENV=production

# Session secret for express-session. Leave blank to auto-generate on first start.
# The generated secret is persisted to <DATA_DIR>/.session-secret and reused on
# subsequent restarts. It is never logged. Only set this if you want to control
# the value yourself (e.g. for replication across multiple instances).
SESSION_SECRET=

# Directory used to persist the auto-generated session secret (and any future
# session store data). Mount this directory to a host volume in containers to
# preserve sessions across image upgrades and restarts.
# Default: ./data
DATA_DIR=

# Optional: name of the header set by an authentication proxy in front of the app
# (e.g. tinyauth, oauth2-proxy, Authelia, Authentik, Traefik forward-auth, Caddy,
# Nginx). When set, the app namespaces per-user torrent lists by the header's
# value and returns 401 to requests without the header. Leave blank to disable.
# Default: empty (feature off)
AUTH_USER_HEADER=

# Number of reverse-proxy hops to trust for `X-Forwarded-*` headers.
# `1` matches "exactly one reverse proxy in front" (e.g. tinyauth).
# `2` covers a CDN in front of the auth proxy. `true` is unsafe (clients can
# spoof X-Forwarded-For). Default: 1
TRUST_PROXY=1

# Logging level: trace, debug, info, warn, error, fatal.
# Default: info. Set to "debug" for verbose Real-Drid response logging.
LOG_LEVEL=info
